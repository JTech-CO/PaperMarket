# Server-only secrets. Never commit .env or rotate the identity key for an existing DB.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
ACCOUNT_IDENTITY_KEY=
# Actual operator identity and email or HTTPS support contact are required.
PAPERMARKET_OPERATOR_NAME=
PAPERMARKET_SUPPORT_CONTACT=
PAPERMARKET_DATABASE_PATH=
# Required persistent 32-64 byte hex secret for the economic engine. Never disclose or replace for an existing DB.
MARKET_SEED=
# Independent persistent AES-256 key (32-byte hex). Keep a separate secure recovery copy; never print it.
BACKUP_KEY=
PAPERMARKET_BACKUP_DIRECTORY=data/backups
# Explicit absolute directory on an independently managed disk/store. Empty means no daily mirror.
PAPERMARKET_BACKUP_MIRROR_DIRECTORY=
